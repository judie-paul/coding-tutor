# Copy this file to .env and fill in your values.
# Real environment variables always take precedence over values in .env.

# --- Application ---
# development or production
APP_ENV=development
APP_ADDR=:8080
DB_PATH=data/tutor.db
# debug, info, warn or error
LOG_LEVEL=info
# How long a login lasts (Go duration: 30m, 12h, 168h ...)
SESSION_TTL=168h
# Must be true in production (requires HTTPS). Defaults to true when APP_ENV=production.
COOKIE_SECURE=false

# --- AI provider (any OpenAI-compatible chat completions API) ---
# OpenAI:      https://api.openai.com/v1
# OpenRouter:  https://openrouter.ai/api/v1
# Groq:        https://api.groq.com/openai/v1
# Ollama:      http://localhost:11434/v1   (no API key needed)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=60s
# Ask the provider for JSON output on structured requests. Set to false if your provider rejects response_format.
AI_JSON_MODE=true
# Maximum AI requests per user per minute
AI_RATE_LIMIT=10
